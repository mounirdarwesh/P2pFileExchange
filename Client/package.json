{
  "name": "p2p_file_transfer",
  "version": "1.0.3",
  "description": "Transfer JSON file from a medical Center to another Peer to Peer Using WebRTC",
  "bin": "client.js",
  "scripts": {
    "start": "node client.js",
    "build": "pkg --compress GZip ."
  },
  "author": "Mounir Darwish",
  "license": "GPL-3.0",
  "dependencies": {
    "@mapbox/node-pre-gyp": "^2.0.0",
    "dotenv": "^16.5.0",
    "ini": "^5.0.0",
    "log4js": "^6.9.1",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.1",
    "wrtc": "^0.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "globals": "^16.2.0"
  },
  "pkg": {
    "scripts": "client.js",
    "assets": [
      "./certificate/**/*",
      ".env",
      "config.ini"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}
